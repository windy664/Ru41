# 补丁式镜像：以上一个 ru41:local 运行时镜像为基底，只替换本次编译的
# 二进制与附属模块文件，跳过全量构建（宿主机磁盘紧张时避免 buildkit 全量层）。
# 由 deploy/build-fast.sh 调用；基底镜像必须已存在（首次需先完整 docker build）。
FROM ru41:local
# codex 的执行环境就是本容器：python3/curl/jq 是 agent 抓数据、跑脚本的基本
# 工具（与主 Dockerfile 同款清单；patch 单独加一层，避免为几个包全量重建）。
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip curl jq \
        ripgrep zip unzip ffmpeg pandoc imagemagick \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --break-system-packages --no-cache-dir requests beautifulsoup4 lxml
COPY target/release/ru41 /usr/local/bin/ru41
COPY src/modules /etc/ru41/modules
COPY .plugins-dist/ /etc/ru41/plugins/
USER node
