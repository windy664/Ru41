[Unit]
Description=校园跑定时跑（每 3 公里一条，间隔与起跑时刻按「像人」的原则算）
# ⚠️ 不要写 Requires=docker.service / After=docker.service：
#    docker.service 是**系统级**单元，用户级 systemd 里根本不存在
#    （systemctl --user list-unit-files 里没有它）。
#    写在用户级 unit 里 → 单元直接起不来：
#      Failed to start campusrun-brush.service: Unit docker.service not found.  (exit=5)
#    → timer 的第一次自动触发必然失败（2026-11-23 实测，service 从没被触发过）。
#    脚本只需要 docker CLI（docker inspect / docker exec），
#    所以改成在 ExecStartPre 里等守护进程就绪，等不到就明确失败。
After=network-online.target

[Service]
Type=oneshot
# 每天触发一次，脚本自己判断今天该不该跑（间隔 >= 2 天 + 目标日程）。
# 提交成绩是不可逆写操作，脚本内部走 submit → confirm 两步。
WorkingDirectory=%h
# 等 docker 就绪（最多 5 分钟）；不 ready 就直接失败，别静默跳过
ExecStartPre=%h/.local/bin/ru41-wait-docker.sh
ExecStart=%h/.local/bin/ru41-campusrun-brush.py
# 预演要拉 OSM 路网/高德瓦片，最多给 20 分钟
TimeoutStartSec=1800
RemainAfterExit=no
