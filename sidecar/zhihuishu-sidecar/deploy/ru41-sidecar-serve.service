[Unit]
Description=智慧树 sidecar 常驻服务(给 ru41 调用: 触发刷课 / 查状态)
After=docker.service

[Service]
Type=simple
WorkingDirectory=%h/Projects/zhihuishu-sidecar
# 容器名固定, 先清掉可能残留的(上次被 kill 时 --rm 可能没跑到)
ExecStartPre=-/usr/bin/docker rm -f ru41-sidecar
# 常驻容器: 带 Playwright + Xvfb, 跑 sidecar 的 HTTP 服务
# 网络用 ru41-net —— ru41 的容器用容器名 ru41-sidecar 直接访问, 不走宿主端口。
ExecStart=/usr/bin/docker run --rm --name ru41-sidecar \
  --network ru41-net \
  -v %h/Projects/zhihuishu-sidecar/config.ini:/app/config.ini:ro \
  -v %h/Projects/zhihuishu-sidecar/data:/app/data \
  -v %h/Projects/zhihuishu-sidecar/logs:/app/logs \
  -v %h/Projects/zhihuishu-sidecar/scripts:/scripts:ro \
  zhihuishu-sidecar:local \
  sh -c 'Xvfb :99 -screen 0 1600x900x24 -nolisten tcp & XPID=$!; sleep 1.5; DISPLAY=:99 python -u /scripts/serve.py --port 9100; kill $XPID 2>/dev/null'
Restart=always
RestartSec=5
# 容器起停有开销, 给足启动宽限
TimeoutStartSec=120
TimeoutStopSec=30
RemainAfterExit=no

[Install]
WantedBy=default.target
