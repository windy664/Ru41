[Unit]
Description=生成智慧树刷课目标(按引擎分流: config.ini / targets.json)
After=docker.service

[Service]
Type=oneshot
# 用户级单元: 放 ~/.config/systemd/user/。
# 纯 stdlib 脚本, 宿主上直接跑(不需要浏览器、不需要容器):
#   读 data/report.json(采集器每晚写)
#   → 选出「有内容可刷 + 没刷完 + 有刷课器认得」的课
#   → 按引擎分流:
#       engine=autovisor → 写 config.ini 的 [course-url] 段(上游 Autovisor 用)
#       engine=polymas   → 写 data/targets.json(自研 brush_polymas.py 用)
#
# 放在 18:45: 赶在 19:00 的刷课之前, 让刷课器拿到当天的目标清单。
WorkingDirectory=%h/Project/zhihuishu-sidecar
ExecStart=/usr/bin/python3 %h/Project/zhihuishu-sidecar/scripts/plan_targets.py
TimeoutStartSec=120
RemainAfterExit=no
