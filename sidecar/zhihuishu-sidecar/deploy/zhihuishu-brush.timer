[Unit]
Description=每晚拉起智慧树视频挂机(自研脚本, 跑完即退)

[Timer]
# 19:00 刷课: 放在「真实使用时段」跑(风控缓解的一条 —— 深夜长时间挂机容易弹
# 人机验证), 也让开 23:30 的作业采集(共用 cookies 目录, 同时跑会互相踩)。
OnCalendar=*-*-* 19:00:00
# 错峰 10 分钟: 避免和别的定时器撞在同一秒抢 CPU/网络。
RandomizedDelaySec=600
# 错过(关机/人在外面没开机)则开机后补跑一次, 别让进度停一周。
Persistent=true

[Install]
WantedBy=timers.target
